# Copy to admin/.env and fill in. Everything is optional except where noted;
# the console tells you on the Status tab what is missing.

# --- Admin server ---
PORT=4747
# Bind address. Keep 127.0.0.1 unless you put this behind auth/HTTPS.
HOST=127.0.0.1
# If set, the browser must supply this token (prompted once, stored locally).
ADMIN_TOKEN=

# --- Station ---
# Timezone that decides what "today" is. Must match Config.luau in the Roblox project.
STATION_TIMEZONE=America/New_York
YEAR_FROM=1960
YEAR_TO=1999

# --- Search ---
# https://dashboard.exa.ai/api-keys  (archive.org search works without any key)
EXA_API_KEY=

# --- Roblox Open Cloud ---
# Create at https://create.roblox.com/dashboard/credentials
# Required permissions:
#   Assets: asset:read, asset:write                       (uploading videos/audio)
#   Data stores (your experience): universe-datastores.objects:read/update/create
#   Messaging service (your experience): universe-messaging-service:publish
ROBLOX_API_KEY=
ROBLOX_UNIVERSE_ID=
# Assets are created under ONE of these. Group takes precedence if both are set.
ROBLOX_CREATOR_USER_ID=
ROBLOX_CREATOR_GROUP_ID=
# Must match Config.luau
ROBLOX_DATASTORE=ThisDayTV
ROBLOX_TOPIC=ThisDayTV
# Roblox charges this many Robux per video upload. Sent as expectedPrice so a
# price change makes the upload fail instead of silently costing more.
ROBLOX_VIDEO_PRICE=2000

# --- Website (web/) ---
# Where the static TV site lives; publishing writes schedules into it.
WEB_DIR=../web
# Streamed programs get a commercial break every this many seconds.
WEB_ACT_SECONDS=720

# --- Media processing (needs ffmpeg + ffprobe on PATH) ---
# Roblox videos must be <= 5 minutes; segments are cut a little under that.
MAX_SEGMENT_SECONDS=295
# Per-request upload cap documented for Open Cloud. Bitrate is chosen to fit.
MAX_UPLOAD_MB=19
